# DashRite — dash-api environment variables
# Set these in Vercel → Project → Settings → Environment Variables.
# Never commit real keys. This file documents the names only.

# --- Bella neural voice (ElevenLabs) — required for /api/tts ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- CORS: the origin allowed to call this backend ---
ALLOW_ORIGIN=https://196969.github.io

# --- QuickBooks Online (scaffold: /api/connect, /api/callback, /api/qbo) ---
# From developer.intuit.com → your app → Keys & credentials.
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REDIRECT_URI=https://YOUR-VERCEL-URL/api/callback
QBO_ENV=sandbox

# --- Bank feed (scaffold: /api/bankfeed, via Plaid) ---
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
