# Copy these into Vercel → Project → Settings → Environment Variables.
# NEVER put real values in Dash, in GitHub, or in chat. They live only on the server.

# --- QuickBooks Online (read-only connector) ---
QBO_CLIENT_ID=from Intuit → Keys & credentials → Development
QBO_CLIENT_SECRET=the NEW secret after "Rotate secret"
QBO_REDIRECT_URI=https://YOUR-PROJECT.vercel.app/api/qbo/callback
QBO_ENV=sandbox
# Any long random phrase, 32+ characters. It seals the QuickBooks token.
TOKEN_KEY=make-up-a-long-random-phrase-at-least-32-characters

# --- Where Dash lives ---
ALLOW_ORIGIN=https://196969.github.io
DASH_URL=https://196969.github.io/dash-app-/

# --- Neural TTS (Bella, optional) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
